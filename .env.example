# WKX Ecosystem localhost configuration contract.
# Copy to .env and adjust; every value is optional. Defaults are computed at
# runtime: scan roots default to the dev directory under your home, port to 8787.
# The bind host is not configurable: the board is loopback-only by design.

# JSON list of directories scanned for git repos.
# WKX_ECO_SCAN_ROOTS=["/path/to/your/dev"]

# Deepest directory level below a scan root that discovery descends into.
# A safety cap against a runaway scan; the generous default suits nested layouts.
# WKX_ECO_SCAN_DEPTH=8

# Port bound on 127.0.0.1.
# WKX_ECO_PORT=8787

# Seconds the disk footprint (du over each repo's .venv and node_modules) is
# cached before it is measured again, so a reload does not re-walk every tree.
# WKX_ECO_FOOTPRINT_CACHE_TTL=60
